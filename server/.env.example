# Server Port
PORT=3000

# Gmail Credentials for saving Drafts
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Go to "App passwords": https://myaccount.google.com/apppasswords
# 3. Create a password named "PostGrab" and paste the 16 characters below:
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional Local LLM (Ollama or OpenCode compatible HTTP endpoint)
AI_ENDPOINT=http://localhost:11434/api/generate
AI_MODEL=llama3

# Set to 'true' to test without Gmail credentials (simulates draft creation)
DRY_RUN=false
