{
  "manifest_version": 3,
  "name": "PostGrab - Safe LinkedIn Post Saver",
  "version": "1.3.0",
  "description": "Persistent right-side companion drawer to safely extract and save visible LinkedIn post text into your local database.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle PostGrab Sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*"],
      "css": ["scripts/content.css"],
      "js": ["scripts/extractor.js", "scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup/popup.html",
        "popup/popup.css",
        "popup/popup.js",
        "scripts/extractor.js",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": ["https://*.linkedin.com/*"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "http://*/*",
    "https://*/*"
  ]
}
